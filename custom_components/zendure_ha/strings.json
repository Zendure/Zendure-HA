{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Zendure",
        "description": "The fleet settings and the connections. Devices are found through the cloud, your local broker, mDNS and Bluetooth, and appear as devices of this integration.",
        "sections": {
          "distribution": {
            "name": "Fleet",
            "data": {
              "max_kw": "Grid connection",
              "max_output": "Maximum delivery to the house",
              "p1_device": "P1 meter",
              "p1_entity": "P1 sensor",
              "mqtt_log": "Log MQTT traffic"
            },
            "data_description": {
              "max_kw": "Capacity of your grid connection, all phases together.",
              "max_output": "Cap on what all batteries together deliver to the house, in W. 0 = no cap. Germany: 800.",
              "p1_device": "The device whose power entities report your grid import and export.",
              "p1_entity": "Optional. One sensor with your net grid power, import positive. When set it is the P1 reading; the P1 meter device then only supplies the phases.",
              "mqtt_log": "Write every MQTT message to zendure_ha_mqtt.jsonl in the config directory."
            }
          },
          "cloud": {
            "name": "Zendure cloud",
            "data": {
              "apptoken": "Home Assistant token",
              "cloud_url": "Cloud MQTT host"
            },
            "data_description": {
              "apptoken": "From the Zendure app: Settings, Developer.",
              "cloud_url": "Filled in automatically from the token."
            }
          },
          "local_broker": {
            "name": "Local MQTT broker",
            "data": {
              "mqtt_host": "Host",
              "mqtt_port": "Port",
              "mqtt_user": "User",
              "mqtt_psw": "Password"
            }
          },
          "wifi": {
            "name": "Wi-Fi",
            "data": {
              "wifi_ssid": "SSID",
              "wifi_psw": "Password"
            }
          }
        }
      },
