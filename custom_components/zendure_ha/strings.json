  "config_subentries": {
    "distribution": {
      "entry_type": "Fleet control",
      "initiate_flow": {
        "user": "Add fleet control"
      },
      "step": {
        "user": {
          "title": "Add fleet control"
        }
      }
    },
    "zendure": {
      "entry_type": "Zendure device",
      "initiate_flow": {
        "user": "Add Zendure device",
        "reconfigure": "Reconfigure device"
      },
      "step": {
        "user": {
          "title": "Add Zendure device",
          "description": "Devices are normally found automatically. Add one by hand only when it never shows up.",
          "data": {
            "prodkey": "Product key",
            "device_id": "Device key",
            "sn": "Serial number",
            "ip": "IP address",
            "blemac": "Bluetooth address"
          },
          "data_description": {
            "prodkey": "The productKey the Zendure cloud reports for the device.",
            "device_id": "The deviceKey the Zendure cloud reports for the device.",
            "sn": "The serial number on the device label.",
            "ip": "Fixed address for the local API; learned automatically when empty.",
            "blemac": "Learned automatically from the Bluetooth advertisement when empty."
          }
        },
        "reconfigure": {
          "title": "{name}",
          "description": "The name of a device never changes; its addresses can.",
          "data": {
            "ip": "IP address",
            "blemac": "Bluetooth address"
          },
          "data_description": {
            "ip": "Fixed address for the local API; learned automatically when empty.",
            "blemac": "Learned automatically from the Bluetooth advertisement when empty."
          }
        }
      },
      "error": {
        "device_exists": "This device is already configured",
        "unknown_prodkey": "Unknown product key"
      },
      "abort": {
        "reconfigure_successful": "Settings saved"
      }
    },
    "solar_panel": {
      "entry_type": "Solar group",
      "initiate_flow": {
        "user": "Add solar group",
        "reconfigure": "Reconfigure solar group"
      },
      "step": {
        "user": {
          "title": "Add solar group",
          "description": "A group of panels on one inverter. The fleet reads its power live and can throttle it when export is not allowed.",
          "data": {
            "name": "Name",
            "power_entity": "Power",
            "derate_entity": "Throttle"
          },
          "data_description": {
            "name": "The name of the group, as it appears in the panel.",
            "power_entity": "The sensor the inverter reports its power on.",
            "derate_entity": "The number entity that limits the inverter; leave empty when it cannot be throttled."
          }
        },
        "reconfigure": {
          "title": "{name}",
          "description": "The name of a solar group never changes; its entities can.",
          "data": {
            "power_entity": "Power",
            "derate_entity": "Throttle"
          },
          "data_description": {
            "power_entity": "The sensor the inverter reports its power on.",
            "derate_entity": "The number entity that limits the inverter; leave empty when it cannot be throttled."
          }
        }
      },
      "abort": {
        "reconfigure_successful": "Settings saved"
      }
    }
  },
