        },
        "reconfigure": {
          "title": "{name}",
          "description": "Der Name eines Geräts ändert sich nie; seine Adressen schon.",
          "data": {
            "ip": "IP-Adresse",
            "blemac": "Bluetooth-Adresse"
          },
          "data_description": {
            "ip": "Feste Adresse für die lokale API; wird automatisch gelernt, wenn leer.",
            "blemac": "Wird automatisch aus der Bluetooth-Ankündigung gelernt, wenn leer."
