    "solar_panel": {
      "entry_type": "Solar group",
      "initiate_flow": {
        "user": "Add solar group",
        "reconfigure": "Reconfigure solar group"
      },
      "step": {
        "user": {
          "title": "Add solar group",
          "description": "A group of panels on one inverter. The fleet reads its power live and can throttle it when export is not allowed.",
          "data": {
            "name": "Name",
            "power_entity": "Power",
            "derate_entity": "Throttle"
          },
          "data_description": {
            "name": "The name of the group, as it appears in the panel.",
            "power_entity": "The sensor the inverter reports its power on.",
            "derate_entity": "The number entity that limits the inverter; leave empty when it cannot be throttled."
          }
        },
        "reconfigure": {
          "title": "{name}",
          "description": "The name of a solar group never changes; its entities can.",
          "data": {
            "power_entity": "Power",
            "derate_entity": "Throttle"
          },
          "data_description": {
            "power_entity": "The sensor the inverter reports its power on.",
