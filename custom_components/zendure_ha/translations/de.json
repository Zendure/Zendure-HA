            "ip": "IP-Adresse",
            "blemac": "Bluetooth-Adresse"
          },
          "data_description": {
            "prodkey": "Der productKey, den die Zendure-Cloud für das Gerät meldet.",
            "device_id": "Der deviceKey, den die Zendure-Cloud für das Gerät meldet.",
